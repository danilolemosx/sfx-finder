{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SFX Finder",
  "mainBinaryName": "sfx-finder",
  "version": "0.2.0",
  "identifier": "com.danilolemos.sfxfinder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SFX Finder",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Music",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/raw2bmx",
      "binaries/llama-server"
    ],
    "shortDescription": "Busca e organiza bancos de efeitos sonoros",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "pt-BR"
      },
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "compression": "none"
      }
    },
    "resources": {
      "modelo/qwen.gguf": "modelo/qwen.gguf"
    }
  }
}
